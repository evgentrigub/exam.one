# LLM credentials
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
LLM_REASONING_EFFORT=medium

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Applications
FRONTEND_PORT=3000
BACKEND_PORT=3001
