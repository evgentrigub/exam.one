# LLM credentials
LLM_PROVIDER=openai # openrouter

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
LLM_REASONING_EFFORT=medium

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Applications
FRONTEND_PORT=3000
FRONTEND_LANDING_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NUXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_PORT=3001
NODE_ENV=development

# Database
POSTGRES_DB=exam_one
POSTGRES_USER=exam_one
POSTGRES_PASSWORD=exam_one
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=exam-one-postgres-dev-data
DATABASE_URL=postgresql://exam_one:exam_one@localhost:5432/exam_one?schema=public

# Auth (required)
# Generate a long random string for production. Rotating this signs everyone out.
JWT_SECRET=change-me-in-production
# Set true behind HTTPS. Keep false for local http://localhost.
AUTH_COOKIE_SECURE=false

# Optional SMTP (default: none). When unset/none, register auto-verifies and
# forgot-password cannot email a link — use: pnpm auth:set-password --email you@example.com
EMAIL_PROVIDER=none # smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=exam.one <noreply@localhost>

# Speech-to-text (local Parakeet or cloud OpenAI)
STT_PROVIDER=local # openai
STT_BASE_URL=http://127.0.0.1:8882
STT_PORT=8882
STT_CPU_THREADS=4
STT_MODEL=handy-computer/parakeet-tdt-0.6b-v3-gguf:Q8_0
STT_OPENAI_MODEL=whisper-1

# Text-to-speech (local four-voice Kokoro)
TTS_BASE_URL=http://127.0.0.1:8881
TTS_PORT=8881
TTS_CPU_THREADS=2
TTS_CONCURRENCY=3
TTS_SPEED=1.0
TTS_LANG=de
TTS_TURN_PAUSE_MS=350
