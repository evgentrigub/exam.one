# AI provider configuration (used by frontend server endpoints during migration, then by backend)
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
LLM_REASONING_EFFORT=medium

# Applications
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# Database
POSTGRES_DB=exam_one
POSTGRES_USER=exam_one
POSTGRES_PASSWORD=exam_one
DATABASE_URL=postgresql://exam_one:exam_one@localhost:5432/exam_one?schema=public

# Auth - to be enabled in later phases
JWT_SECRET=change-me-in-production
