# exam.one environment template
#
# Copy to `.env` in the repository root:
#   cp .env.example .env
#
# NestJS loads this file as `../../.env`. Nuxt loads it via `--dotenv ../../.env`.
# Docker Compose interpolates the same file into `compose.yaml`.
# Restart `pnpm dev` or `pnpm stack:up` after changing values.

# -----------------------------------------------------------------------------
# Applications and network
# -----------------------------------------------------------------------------
# Host ports published by Compose (and used by local `pnpm dev`).
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
NUXT_PUBLIC_API_URL=http://localhost:3001
# Browser-facing API/docs landing URL used by the Nuxt runtime config.
FRONTEND_LANDING_URL=http://localhost:3001
# Browser-facing user documentation URL, including any deployment base path.
# Nuxt deployments can override this with NUXT_PUBLIC_DOCS_URL at runtime.
DOCS_URL=http://localhost:3012
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB=exam_one
POSTGRES_USER=exam_one
POSTGRES_PASSWORD=exam_one
POSTGRES_PORT=5432
# Named Docker volume for PostgreSQL data. Survives `pnpm stack:down`.
# Change this if you run more than one instance on the same Docker engine.
POSTGRES_VOLUME_NAME=exam-one-postgres-dev-data
# Host-side Prisma URL (local `pnpm dev` and `pnpm auth:set-password`).
# Compose rebuilds DATABASE_URL from POSTGRES_* and the `postgres` hostname.
DATABASE_URL=postgresql://exam_one:exam_one@localhost:5432/exam_one?schema=public
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
REDIS_VOLUME_NAME=exam-one-redis-dev-data
JOBS_WORKER_ENABLED=true
# Optional Bull Board; enable only behind HTTPS outside localhost.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# -----------------------------------------------------------------------------
# Auth (required)
# -----------------------------------------------------------------------------
# Required. Must be at least 32 characters and must not be the example placeholder.
# Generate before first boot:
#   openssl rand -base64 48
# Rotating JWT_SECRET invalidates every session and signs everyone out.
JWT_SECRET=
# Required. Encrypts the LLM API keys users save in Settings → AI provider.
# Generate before first boot (base64 for exactly 32 bytes):
#   openssl rand -base64 32
# Rotating it makes saved keys unreadable; users then paste their keys again.
SECRETS_ENCRYPTION_KEY=
# Set true behind HTTPS. Keep false for local http://localhost.
AUTH_COOKIE_SECURE=false
# Compose sets NODE_ENV=production, so Swagger stays off unless this is true.
# Local `pnpm dev` serves /api/docs unless SWAGGER_ENABLED=false.
# SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Optional SMTP
# -----------------------------------------------------------------------------
# none  — register auto-verifies; forgot-password cannot email a link.
#         Recover with: pnpm auth:set-password --email you@example.com
# smtp  — send verify/reset mail through SMTP_HOST.
EMAIL_PROVIDER=none # smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=exam.one <noreply@localhost>

# -----------------------------------------------------------------------------
# Speech-to-text (local Phonon / Parakeet, started by `pnpm stt:up` / `pnpm stack:up`)
# -----------------------------------------------------------------------------
STT_BASE_URL=http://127.0.0.1:8882
STT_PORT=8882
STT_CPU_THREADS=4
# Initial setup downloads English only (Phonon). German/Polish/Spanish default to shared Parakeet Q4.
# Other languages can be added from Settings. Setup installs/selects the recommended models.
STT_SETUP_LANGS=en
# Permitted languages; availability also requires the selected model to be installed.
STT_LANGUAGES=de,en,pl,es

# -----------------------------------------------------------------------------
# Text-to-speech (local: German, British English and Spanish on Kokoro, Polish on Piper)
# -----------------------------------------------------------------------------
TTS_BASE_URL=http://127.0.0.1:8881
TTS_PORT=8881
TTS_CPU_THREADS=2
TTS_CONCURRENCY=3
TTS_SPEED=1.0
# Languages whose voices `pnpm tts:setup` downloads up front. English only by default; add more
# here (de,en,pl,es) or download single voices later in Settings → Generated files → Voice
# models. The TTS service loads every voice installed under scripts/tts/victoria/models.
KOKORO_LANGS=en
# Languages exam packs may use on this instance. TTS_LANG is the older single-language form.
TTS_LANGUAGES=de,en,pl,es
TTS_LANG=en
# Voice IDs available on the installed TTS instance.
TTS_VOICES=martin,bernd,victoria,eva,bf_emma,bf_isabella,bm_george,bm_fable,pl_gosia,pl_darkman,pl_bass,ef_dora,em_alex,em_santa
TTS_VOICE=martin
TTS_TURN_PAUSE_MS=350
# Silence between concatenated dialogue turns inside the Kokoro container (seconds).
TTS_PAUSE_DURATION=0.25

# Optional. Local `pnpm dev` defaults to apps/frontend/public/audio/listening (seed WAVs) and
# its generated/ subfolder (per-user audio). Compose bind-mounts that host folder into the
# backend at /app/data/listening and sets both paths.
# SEED_LISTENING_AUDIO_DIR=
# GENERATED_LISTENING_AUDIO_DIR=
# How Settings → Generated files shows file locations (a host path, display only).
# AUDIO_HOST_DISPLAY_ROOT=apps/frontend/public/audio/listening

# Optional. Packs whose bundled listening WAVs `pnpm stack:seed-audio` generates: a comma list
# or `all`. Defaults to the default pack (cambridge-en-a2).
# STACK_SEED_PACKS=cambridge-en-a2

# Optional. How long `pnpm stack:seed-audio` waits for Kokoro (milliseconds).
# STACK_SEED_AUDIO_TIMEOUT_MS=480000
