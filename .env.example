# LLM credentials
LLM_PROVIDER=openai # openrouter

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
LLM_REASONING_EFFORT=medium

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Applications
FRONTEND_PORT=3000
BACKEND_PORT=3001
NODE_ENV=development

# Database
POSTGRES_DB=exam_one
POSTGRES_USER=exam_one
POSTGRES_PASSWORD=exam_one
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=exam-one-postgres-dev-data
DATABASE_URL=postgresql://exam_one:exam_one@localhost:5432/exam_one?schema=public

# Auth - to be enabled in later phases
JWT_SECRET=change-me-in-production

# Speech-to-text (local Parakeet or cloud OpenAI)
STT_PROVIDER=local # openai
STT_BASE_URL=http://127.0.0.1:8882
STT_PORT=8882
STT_CPU_THREADS=4
STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
STT_OPENAI_MODEL=whisper-1

# Text-to-speech (local four-voice Kokoro)
TTS_BASE_URL=http://127.0.0.1:8881
TTS_PORT=8881
TTS_CPU_THREADS=2
TTS_CONCURRENCY=3
TTS_SPEED=1.0
TTS_LANG=de
TTS_TURN_PAUSE_MS=350
