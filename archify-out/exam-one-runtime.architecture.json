  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Login-gated catalogs, attempts, drafts, and mock sets hydrate from /api/v1",
        "apiFetch sends cookies and retries once on 401 via /auth/refresh"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and ownership",
      "items": [
        "Operator owns Compose; Postgres, Kokoro, and Parakeet bind 127.0.0.1",
        "HttpOnly exam_one_access (15m) plus hashed exam_one_refresh (30d)"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional AI and persistence",
      "items": [
        "Missing LLM keys or sidecars return HTTP 200 { data: null, error }; Set 1 still works",
        "Prisma seeds from @exam-one/exam-packs; theme and playback stay in the browser"
      ]
    }
  ]
