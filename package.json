{
  "name": "exam-one",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "scripts": {
    "dev": "pnpm --filter ./apps/frontend --filter ./apps/backend --parallel dev",
    "dev:frontend": "pnpm --filter ./apps/frontend dev",
    "dev:backend": "pnpm --filter ./apps/backend dev",
    "dev:infra": "docker compose up -d --wait postgres redis",
    "dev:infra:down": "docker compose stop postgres redis",
    "dev:infra:logs": "docker compose logs -f postgres redis",
    "dev:db:shell": "docker compose exec postgres psql -U ${POSTGRES_USER:-exam_one} -d ${POSTGRES_DB:-exam_one}",
    "build": "pnpm --recursive --workspace-concurrency=1 build",
    "build:frontend": "pnpm --filter ./apps/frontend build",
    "build:backend": "pnpm --filter ./apps/backend build",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "prettier --write . \"!graphify-out/**\" \"!scripts/**\"",
    "type-check": "pnpm --recursive type-check",
    "i18n:check": "node scripts/check-locale-parity.mjs",
    "test": "pnpm --recursive test",
    "test:full": "pnpm test:frontend && pnpm test:backend && pnpm test:e2e",
    "test:all": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "pnpm --filter ./apps/frontend test",
    "test:backend": "pnpm --filter ./apps/backend test",
    "test:e2e": "pnpm --filter ./apps/backend test:e2e",
    "db:validate": "pnpm --filter @exam-one/database db:validate",
    "db:migrate": "pnpm --filter @exam-one/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @exam-one/database db:migrate:deploy",
    "db:seed": "pnpm --filter @exam-one/database db:seed",
    "db:prune": "pnpm --filter @exam-one/database db:prune",
    "db:reset-practice": "pnpm db:prune && pnpm db:seed",
    "auth:set-password": "pnpm --filter @exam-one/database auth:set-password",
    "generate:listening-audio": "node scripts/generate-listening-audio.mjs",
    "stack:setup": "pnpm tts:setup && pnpm stt:setup",
    "stack:models": "pnpm stack:setup",
    "stack:verify-models": "node scripts/stack-verify-models.mjs",
    "stack:seed-audio": "node scripts/stack-seed-audio.mjs",
    "stack:up": "pnpm stack:setup && pnpm stack:verify-models && mkdir -p apps/frontend/public/audio/listening/generated && docker compose up -d --build --wait postgres redis backend frontend && docker compose up -d --build kokoro-voices parakeet && pnpm stack:seed-audio",
    "stack:down": "docker compose down --remove-orphans",
    "stack:logs": "docker compose logs -f",
    "stack:ps": "docker compose ps",
    "tts:setup": "bash scripts/tts/victoria/download-models.sh",
    "tts:test": "cd scripts/tts/victoria && python3 -m unittest test_voice_catalog",
    "tts:up": "pnpm tts:setup && docker compose up -d --build --wait kokoro-voices",
    "tts:down": "docker compose stop kokoro-voices",
    "stt:setup": "bash scripts/stt/parakeet/download-models.sh",
    "stt:up": "pnpm stt:setup && docker compose up -d --build --wait parakeet",
    "stt:down": "docker compose stop parakeet"
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
