generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Skill {
  READING
  WRITING
  LISTENING
  SPEAKING
  MOCK
}

enum PlanId {
  FREE
  PRO
}

enum ExamLevel {
  A2
  C1
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  REFRESH
}

enum ExerciseVisibility {
  PRACTICE
  EXAM_ONLY
}

enum BackgroundJobType {
  LISTENING_AUDIO
  EXERCISE_GENERATION
  MOCK_EXAM_SET
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  COMPLETED
  FAILED
  CANCELLED
}

enum PromptKind {
  GENERATOR
  ANSWER
  REVIEW
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  examTargetDate   DateTime?
  plan             PlanId            @default(FREE)
  passwordHash     String?
  emailVerified    Boolean           @default(false)
  settings         Setting?
  exercises        Exercise[]
  attempts         Attempt[]
  drafts           Draft[]
  authTokens       AuthToken[]
  mockExamSets     MockExamSet[]
  mockExamAttempts MockExamAttempt[]
  backgroundJobs   BackgroundJob[]
  promptOverrides  PromptOverride[]
  llmCredentials   LlmCredential[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AuthTokenType
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([userId, type])
  @@index([tokenHash])
}

model Setting {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId         String    @default("cambridge-en-a2")
  examLevel      String    @default("A2")
  targetLanguage String    @default("en")
  /// Preferred TTS voice per language, `{ [lang]: voiceId }`; set in Settings → Voice models.
  defaultVoices  Json      @default("{}")
  notifyMockReadyEmail Boolean @default(true)
  /// Active LLM provider (`openai` | `openrouter` | `gemini` | `anthropic` | `xai`); null until chosen in Settings → AI provider.
  llmProvider        String?
  llmModel           String?
  /// Tried in order when the main model is rate-limited or unavailable (max 3).
  llmFallbackModels  String[]  @default([])
  llmReasoningEffort String    @default("medium")
  updatedAt      DateTime  @updatedAt
}

/// One saved API key per user and provider, encrypted with SECRETS_ENCRYPTION_KEY.
model LlmCredential {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  keyCiphertext String
  keyLast4      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, provider])
}

model Exercise {
  id          String              @id @default(cuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId      String              @default("goethe-de-a2")
  skill       Skill
  level       String              @default("A2")
  source      String              @default("seed") // seed | generated
  visibility  ExerciseVisibility  @default(PRACTICE)
  externalId  String
  payload     Json
  attempts    Attempt[]
  createdAt   DateTime            @default(now())

  @@unique([userId, skill, packId, externalId])
  @@index([packId, skill, level, visibility])
  @@index([userId, skill])
  @@index([source, packId, externalId])
}

model Attempt {
  packId    String @default("goethe-de-a2")
  snapshot  Json?
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  skill      Skill
  answers    Json
  result     Result?
  submittedAt DateTime @default(now())

  @@index([userId, skill])
  @@index([exerciseId])
}

model Result {
  id         String   @id @default(cuid())
  attemptId  String   @unique
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  score      Float?
  maxScore   Float?
  percentage Int?
  review     Json?
  createdAt  DateTime @default(now())
}

model Draft {
  packId    String @default("goethe-de-a2")
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @default(WRITING)
  topicId   String
  payload   Json
  updatedAt DateTime @updatedAt

  @@unique([userId, packId, skill, topicId])
}

model MockExamSet {
  packId    String @default("goethe-de-a2")
  id         String            @id @default(cuid())
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId String
  examId     String
  level      String
  title      String
  generated  Boolean           @default(false)
  content    Json
  modules    Json
  rules      Json?
  createdAt  DateTime          @default(now())
  attempts   MockExamAttempt[]

  @@unique([userId, packId, externalId])
  @@index([userId])
}

model MockExamAttempt {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId     String
  set       MockExamSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  state     Json
  updatedAt DateTime    @updatedAt

  @@unique([userId, setId])
}

model BackgroundJob {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId           String
  level            String
  type             BackgroundJobType
  status           BackgroundJobStatus @default(QUEUED)
  title            String
  subtitle         String?
  targetId         String?
  activeKey        String?             @unique
  input            Json
  progress         Json                @default("{}")
  checkpoint       Json                @default("{}")
  result           Json?
  error            String?
  attempt          Int                 @default(0)
  revision         Int                 @default(0)
  seenAt           DateTime?
  emailAttemptedAt DateTime?
  createdAt        DateTime            @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  updatedAt        DateTime            @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
}

model PromptOverride {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill
  level     ExamLevel
  part      Int
  kind      PromptKind
  body      String
  updatedAt DateTime   @updatedAt

  @@unique([userId, skill, level, part, kind])
  @@index([userId])
}
